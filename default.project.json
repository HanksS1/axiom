{
  "name": "AxiomWarExtraction",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/Shared"
      }
    },
    "ReplicatedFirst": {
      "Loading": {
        "$path": "src/ReplicatedFirst"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/Server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/Client"
        }
      },
      "$properties": {
        "EnableMouseLockOption": false,
        "CharacterUseJumpPower": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}
