--!nocheck
-- Utilitaires : Guard, RateLimiter, Signal, Freeze, Leveling.

return function(T, H)
	local describe, it, expect = T.describe, T.it, T.expect
	local Guard = H.require("ReplicatedStorage/Shared/Util/Guard")
	local RateLimiter = H.require("ReplicatedStorage/Shared/Util/RateLimiter")
	local Freeze = H.require("ReplicatedStorage/Shared/Util/Freeze")
	local Leveling = H.require("ReplicatedStorage/Shared/Progression/Leveling")
	local Signal = H.require("ReplicatedStorage/Shared/Util/Signal")
	local try = H.require("ReplicatedStorage/Shared/Util/Try")
	local task = require("@lune/task")
	local roblox = require("@lune/roblox")

	describe("Guard", function()
		it("nombres : rejette NaN, infini, hors bornes", function()
			local check = Guard.number(0, 10)
			expect(check(5)).toBe(true)
			expect(check(0 / 0)).toBe(false)
			expect(check(math.huge)).toBe(false)
			expect(check(-math.huge)).toBe(false)
			expect(check(11)).toBe(false)
			expect(check("5")).toBe(false)
			expect(Guard.integer(0, 10)(2.5)).toBe(false)
			expect(Guard.integer(0, 10)(3)).toBe(true)
		end)

		it("chaînes : longueur et motif", function()
			expect(Guard.string(5)("abc")).toBe(true)
			expect(Guard.string(5)("abcdef")).toBe(false)
			expect(Guard.uid()("1A2B-3c4d_5")).toBe(true)
			expect(Guard.uid()("a b")).toBe(false)
			expect(Guard.uid()(string.rep("a", 65))).toBe(false)
		end)

		it("énumérations et clés de config", function()
			expect(Guard.enum({ "a", "b" })("a")).toBe(true)
			expect(Guard.enum({ "a", "b" })("c")).toBe(false)
			expect(Guard.keyOf({ x = 1 })("x")).toBe(true)
			expect(Guard.keyOf({ x = 1 })("__index")).toBe(false)
		end)

		it("Vector3 : type, finitude, norme", function()
			local check = Guard.vector3(100)
			expect(check(roblox.Vector3.new(1, 2, 3))).toBe(true)
			expect(check(roblox.Vector3.new(0 / 0, 0, 0))).toBe(false)
			expect(check(roblox.Vector3.new(1000, 0, 0))).toBe(false)
			expect(check({ X = 1, Y = 2, Z = 3 })).toBe(false)
			expect(Guard.unitVector()(roblox.Vector3.new(0, 1, 0))).toBe(true)
			expect(Guard.unitVector()(roblox.Vector3.new(0, 2, 0))).toBe(false)
		end)

		it("structures : clés exactes", function()
			local check = Guard.struct({ a = Guard.number(), b = Guard.optional(Guard.boolean()) })
			expect(check({ a = 1 })).toBe(true)
			expect(check({ a = 1, b = true })).toBe(true)
			expect(check({ a = 1, c = 2 })).toBe(false)
			expect(check({ b = true })).toBe(false)
			expect(check("x")).toBe(false)
		end)

		it("tableaux : séquentiels, sans trou, taille bornée", function()
			local check = Guard.array(Guard.integer(), 3)
			expect(check({ 1, 2, 3 })).toBe(true)
			expect(check({})).toBe(true)
			expect(check({ 1, 2, 3, 4 })).toBe(false)
			expect(check({ [1] = 1, [3] = 3 })).toBe(false)
			expect(check({ 1, x = 2 })).toBe(false)
			expect(check({ 1, "a" })).toBe(false)
		end)

		it("tuple : nombre d'arguments", function()
			local check = Guard.tuple(Guard.string(10), Guard.optional(Guard.integer()))
			expect(check("a")).toBe(true)
			expect(check("a", 2)).toBe(true)
			expect(check("a", 2, 3)).toBe(false)
			expect(check()).toBe(false)
			expect(Guard.tuple()()).toBe(true)
			expect(Guard.tuple()(1)).toBe(false)
		end)
	end)

	describe("RateLimiter", function()
		it("seau à jetons avec horloge simulée", function()
			local now = 0
			local limiter = RateLimiter.new(2, 3, function()
				return now
			end)
			expect(limiter:consume("p")).toBe(true)
			expect(limiter:consume("p")).toBe(true)
			expect(limiter:consume("p")).toBe(true)
			expect(limiter:consume("p")).toBe(false)
			-- Une autre clé a son propre seau.
			expect(limiter:consume("q")).toBe(true)
			now = 0.5 -- +1 jeton
			expect(limiter:consume("p")).toBe(true)
			expect(limiter:consume("p")).toBe(false)
			now = 100 -- plafonné à `burst`
			for _ = 1, 3 do
				expect(limiter:consume("p")).toBe(true)
			end
			expect(limiter:consume("p")).toBe(false)
			limiter:reset("p")
			expect(limiter:consume("p")).toBe(true)
		end)
	end)

	describe("Freeze", function()
		it("gel profond et copie modifiable", function()
			local data = Freeze.deep({ a = { b = { c = 1 } } })
			expect(table.isfrozen(data.a.b)).toBe(true)
			local copy = Freeze.copy(data)
			copy.a.b.c = 2
			expect(data.a.b.c).toBe(1)
			expect(table.isfrozen(copy)).toBe(false)
		end)
	end)

	describe("Leveling", function()
		it("XP nécessaire : 500 + 150 × n", function()
			expect(Leveling.xpToNext(1)).toBe(650)
			expect(Leveling.xpToNext(2)).toBe(800)
		end)

		it("passage de plusieurs niveaux", function()
			local level, xp, gained = Leveling.addXp(1, 0, 650 + 800 + 10)
			expect(level).toBe(3)
			expect(xp).toBe(10)
			expect(gained).toBe(2)
			level, xp, gained = Leveling.addXp(1, 0, -50)
			expect(level).toBe(1)
			expect(xp).toBe(0)
			expect(gained).toBe(0)
		end)

		it("XP de partie : 50 % du score + 100", function()
			expect(Leveling.matchXp(1000)).toBe(600)
			expect(Leveling.matchXp(0)).toBe(100)
		end)
	end)

	describe("Signal", function()
		it("Connect / Fire / Disconnect / Once", function()
			local signal = Signal.new()
			local received = {}
			local connection = signal:Connect(function(value)
				table.insert(received, value)
			end)
			local onceCount = 0
			signal:Once(function()
				onceCount += 1
			end)
			signal:Fire(1)
			signal:Fire(2)
			connection:Disconnect()
			signal:Fire(3)
			task.wait()
			expect(#received).toBe(2)
			expect(received[2]).toBe(2)
			expect(onceCount).toBe(1)
			expect(connection.Connected).toBe(false)
		end)
	end)

	describe("Try", function()
		it("retourne le succès ou le message d'erreur", function()
			local ok, err = try(function() end)
			expect(ok).toBe(true)
			expect(err).toBeNil()
			ok, err = try(function()
				error("boum", 0)
			end)
			expect(ok).toBe(false)
			expect(err).toBe("boum")
		end)
	end)
end
