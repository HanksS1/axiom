	["npc.keeper.name"] = "The Keeper",
	["npc.keeper.line.1"] = "What you bring back, I keep. What you lose… AXIOM keeps.",
	["npc.keeper.line.2"] = "Thirty storage units. Not one more. Walls have ears, and limits.",
	["npc.keeper.line.3"] = "My eye never sleeps. I left the other one in Neo-Lumen.",
	["npc.scrap.name"] = "Rust",
	["npc.scrap.line.1"] = "Everything sells, mercenary. Even your regrets, at a fair price.",
	["npc.scrap.line.2"] = "Don't breathe too hard, the air down here costs more than my cells.",
	["npc.scrap.line.3"] = "Badly damaged? I'll take it. Pristine? I don't ask questions.",
	["npc.spark.name"] = "Spark",
	["npc.spark.line.1"] = "Come closer. Not too close. The torch has moods.",
	["npc.spark.line.2"] = "I fix everything, except bad decisions.",
	["npc.spark.line.3"] = "I welded this arm myself. The other one is on back order.",
	["npc.actuary.name"] = "The Actuary",
	["npc.actuary.line.1"] = "Statistically, you won't come back. Let's make sure your gear does.",
	["npc.actuary.line.2"] = "Risk is a number. I am a face. More or less.",
	["npc.actuary.line.3"] = "Sign here. Or don't. AXIOM already signed for you.",
	["npc.nea.name"] = "Nea",
	["npc.nea.line.1"] = "Welcome to the Holo-Bazaar! I'm made of light… and very good prices.",
	["npc.nea.line.2"] = "A skin won't stop bullets. But you'll look great when they arrive.",
	["npc.nea.line.3"] = "My rotation changes at midnight. I stay. I'm stuck in this projector.",
	["npc.ferryman.name"] = "The Ferryman",
	["npc.ferryman.line.1"] = "Behind this door, the surface. In front of it, those who came back.",
	["npc.ferryman.line.2"] = "Fifteen minutes. Then, the Purge. Don't keep me waiting.",
	["npc.ferryman.line.3"] = "I take you across. I don't promise the way back.",
	["npc.hertz.name"] = "Old Hertz",
	["npc.hertz.line.1"] = "Aim low, shoot true, reload before you need to.",
	["npc.hertz.line.2"] = "This eye? A nosy Sentinel. It lost both of its own.",
	["npc.hertz.line.3"] = "Targets don't shoot back. Enjoy it.",
	["npc.archivist.name"] = "The Archivist",
	["npc.archivist.line.1"] = "Every name on this wall survived long enough to be remembered.",
	["npc.archivist.line.2"] = "AXIOM erases everything. I copy it back.",
	["npc.archivist.line.3"] = "The cubes orbit me. Legends orbit their deeds.",
	["hub.poster.1"] = "AXIOM WATCHES OVER YOU",
	["hub.poster.2"] = "OBEY TO SURVIVE",
